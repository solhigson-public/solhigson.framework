<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <PackageId>Solhigson.Utilities</PackageId>
        <Authors>Solhigson</Authors>
        <Description>Utility Library</Description>
        <IsPackable>true</IsPackable>
        <Version>1.0.0</Version>
        <PackageVersion>10.2.0</PackageVersion>
        <PackageReleaseNotes>10.2.0: HelperFunctions.SafeGetSessionData, SafeSetSessionData and SafeRemoveSessionData no longer use thread named data slots (Thread.GetNamedDataSlot / Thread.SetData / Thread.GetData). Reads never consult a thread slot: a read through a null context, or through a live session that lacks the key, returns null; a write or remove without a session is a silent no-op. The HTTP-session path is unchanged when the key is present. Also in 10.2.0: Serializer.SerializeToJson with custom JsonSerializerOptions uses those options as given, so indent: true no longer forces WriteIndented on them (073f040).</PackageReleaseNotes>
        <PackageProjectUrl>https://github.com/solhigson-public/solhigson.framework</PackageProjectUrl>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Solhigson.Utilities.Tests" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.1" />
      <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.15.0" />

      <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.15.0" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
</Project>
